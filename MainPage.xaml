<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WebKitBrowser.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WebKitBrowser"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded">

    <Grid x:Name="LayoutRoot" RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TabView
            x:Name="TabStrip"
            Grid.Row="0"
            Height="44"
            IsAddTabButtonVisible="True"
            CanReorderTabs="True"
            AddTabButtonClick="OnAddTabButtonClick"
            TabCloseRequested="OnTabCloseRequested"
            SelectionChanged="OnTabSelectionChanged"
            AutomationProperties.Name="Browser tabs" />

        <Grid
            x:Name="Toolbar"
            Grid.Row="1"
            Height="56"
            Padding="12,6"
            ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button x:Name="BackButton" Grid.Column="0" Content="Back" Click="OnBackClick" AutomationProperties.Name="Go back" />
            <Button x:Name="ForwardButton" Grid.Column="1" Content="Forward" Click="OnForwardClick" AutomationProperties.Name="Go forward" />
            <Button Grid.Column="2" Content="Reload" Click="OnReloadClick" AutomationProperties.Name="Reload page" />
            <Button Grid.Column="3" Content="Stop" Click="OnStopClick" AutomationProperties.Name="Stop loading" />
            <Button Grid.Column="4" Content="Home" Click="OnHomeClick" AutomationProperties.Name="Go to home page" />

            <AutoSuggestBox
                x:Name="AddressBox"
                Grid.Column="5"
                MinWidth="180"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                PlaceholderText="Search or enter address"
                QuerySubmitted="OnAddressQuerySubmitted"
                AutomationProperties.Name="Address and search">
                <AutoSuggestBox.QueryIcon>
                    <SymbolIcon Symbol="Find" />
                </AutoSuggestBox.QueryIcon>
            </AutoSuggestBox>

            <Button x:Name="BookmarkButton" Grid.Column="6" Content="Bookmark" Click="OnBookmarkClick" AutomationProperties.Name="Add or remove bookmark" />
            <Button Grid.Column="7" Content="Saved" Click="OnBookmarksClick" AutomationProperties.Name="Open bookmarks" />
            <Button Grid.Column="8" Content="History" Click="OnHistoryClick" AutomationProperties.Name="Open browsing history" />
            <Button Grid.Column="9" Content="Downloads" Click="OnDownloadsClick" AutomationProperties.Name="Open downloads" />
            <Button Grid.Column="10" Content="Settings" Click="OnSettingsClick" AutomationProperties.Name="Open browser settings" />
        </Grid>

        <Grid
            x:Name="BrowserSurface"
            Grid.Row="2"
            Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
            SizeChanged="OnBrowserSurfaceSizeChanged">
            <InfoBar
                x:Name="EngineError"
                IsOpen="False"
                IsClosable="True"
                Severity="Error"
                Title="WebKit engine unavailable"
                Message="The WinCairo runtime could not be loaded. This browser will not fall back to Chromium or WebView2." />
        </Grid>
    </Grid>
</Page>
