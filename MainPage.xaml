<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WebKitBrowser.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded">

    <Grid x:Name="LayoutRoot" RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TabView
            x:Name="TabStrip"
            Grid.Row="0"
            Height="44"
            IsAddTabButtonVisible="True"
            CanReorderTabs="True"
            AddTabButtonClick="OnAddTabButtonClick"
            TabCloseRequested="OnTabCloseRequested"
            SelectionChanged="OnTabSelectionChanged"
            AutomationProperties.Name="Browser tabs"
            AutomationProperties.AutomationId="BrowserTabStrip" />

        <!-- Native WinUI buttons use Segoe Fluent glyphs, visible labels and accessible names. -->
        <Grid
            x:Name="Toolbar"
            Grid.Row="1"
            Padding="12,6"
            ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button
                x:Name="BackButton"
                Grid.Column="0"
                
                Click="OnBackClick"
                VerticalAlignment="Center"
                AutomationProperties.Name="Go back"
                AutomationProperties.AutomationId="BackButton" ToolTipService.ToolTip="Go back">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE72B;" FontSize="16" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                    <TextBlock Text="Back" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button
                x:Name="ForwardButton"
                Grid.Column="1"
                
                Click="OnForwardClick"
                VerticalAlignment="Center"
                AutomationProperties.Name="Go forward"
                AutomationProperties.AutomationId="ForwardButton" ToolTipService.ToolTip="Go forward">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE72A;" FontSize="16" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                    <TextBlock Text="Forward" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button
                Grid.Column="2"
                
                Click="OnReloadClick"
                VerticalAlignment="Center"
                AutomationProperties.Name="Reload page"
                AutomationProperties.AutomationId="ReloadButton" ToolTipService.ToolTip="Reload page">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE72C;" FontSize="16" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                    <TextBlock Text="Reload" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button
                Grid.Column="3"
                
                Click="OnStopClick"
                VerticalAlignment="Center"
                AutomationProperties.Name="Stop loading"
                AutomationProperties.AutomationId="StopButton" ToolTipService.ToolTip="Stop loading">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE71A;" FontSize="16" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                    <TextBlock Text="Stop" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button
                Grid.Column="4"
                
                Click="OnHomeClick"
                VerticalAlignment="Center"
                AutomationProperties.Name="Go to home page"
                AutomationProperties.AutomationId="HomeButton" ToolTipService.ToolTip="Go to home page">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE80F;" FontSize="16" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                    <TextBlock Text="Home" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <AutoSuggestBox
                x:Name="AddressBox"
                Grid.Column="5"
                MinWidth="180"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                PlaceholderText="Search or enter address"
                QuerySubmitted="OnAddressQuerySubmitted"
                AutomationProperties.Name="Address and search" AutomationProperties.AutomationId="AddressBox">
                <AutoSuggestBox.QueryIcon>
                    <SymbolIcon Symbol="Find" />
                </AutoSuggestBox.QueryIcon>
            </AutoSuggestBox>

            <Button
                x:Name="BookmarkButton"
                Grid.Column="6"
                
                Click="OnBookmarkClick"
                VerticalAlignment="Center"
                AutomationProperties.Name="Add or remove bookmark"
                AutomationProperties.AutomationId="BookmarkButton" ToolTipService.ToolTip="Add or remove bookmark">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE8A4;" FontSize="16" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                    <TextBlock Text="Bookmark" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button
                Grid.Column="7"
                
                Click="OnBookmarksClick"
                VerticalAlignment="Center"
                AutomationProperties.Name="Open bookmarks"
                AutomationProperties.AutomationId="BookmarksButton" ToolTipService.ToolTip="Open saved bookmarks">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE8A4;" FontSize="16" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                    <TextBlock Text="Saved" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button
                Grid.Column="8"
                
                Click="OnHistoryClick"
                VerticalAlignment="Center"
                AutomationProperties.Name="Open browsing history"
                AutomationProperties.AutomationId="HistoryButton" ToolTipService.ToolTip="Open browsing history">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE81C;" FontSize="16" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                    <TextBlock Text="History" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button
                Grid.Column="9"
                
                Click="OnDownloadsClick"
                VerticalAlignment="Center"
                AutomationProperties.Name="Open downloads"
                AutomationProperties.AutomationId="DownloadsButton" ToolTipService.ToolTip="Open downloads">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE896;" FontSize="16" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                    <TextBlock Text="Downloads" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button
                Grid.Column="10"
                
                Click="OnSettingsClick"
                VerticalAlignment="Center"
                AutomationProperties.Name="Open browser settings"
                AutomationProperties.AutomationId="SettingsButton" ToolTipService.ToolTip="Open browser settings">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE713;" FontSize="16" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                    <TextBlock Text="Settings" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <Grid
            x:Name="BrowserSurface"
            Grid.Row="2"
            Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
            SizeChanged="OnBrowserSurfaceSizeChanged">
            <InfoBar
                x:Name="EngineError"
                IsOpen="False"
                IsClosable="True"
                Severity="Error"
                Title="WebKit engine unavailable"
                Message="The WinCairo runtime could not be loaded. This browser will not fall back to Chromium or WebView2." />

            <!-- Native WinUI start page; no remote website is loaded for a new tab. -->
            <Grid
                x:Name="StartPageSurface"
                Visibility="Collapsed"
                Padding="32"
                Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                AutomationProperties.Name="Blaze start page"
                AutomationProperties.AutomationId="StartPageSurface">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Spacing="4" HorizontalAlignment="Center" Margin="0,28,0,0">
                    <TextBlock
                        Text="Blaze"
                        Style="{StaticResource TitleTextBlockStyle}"
                        HorizontalTextAlignment="Center" />
                    <TextBlock
                        Text="A fresh place to start browsing."
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        HorizontalTextAlignment="Center" />
                </StackPanel>

                <AutoSuggestBox
                    x:Name="StartPageSearchBox"
                    Grid.Row="1"
                    MaxWidth="720"
                    HorizontalAlignment="Stretch"
                    Margin="16,28,16,12"
                    PlaceholderText="Search the web or enter an address"
                    QuerySubmitted="OnStartPageSearchQuerySubmitted"
                    AutomationProperties.Name="Start page search"
                    AutomationProperties.AutomationId="StartPageSearchBox">
                    <AutoSuggestBox.QueryIcon>
                        <SymbolIcon Symbol="Find" />
                    </AutoSuggestBox.QueryIcon>
                </AutoSuggestBox>

                <TextBlock
                    Grid.Row="2"
                    Text="Quick links"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Margin="0,20,0,12"
                    HorizontalAlignment="Center" />

                <GridView
                    x:Name="StartPageShortcutsGrid"
                    Grid.Row="3"
                    ItemsSource="{x:Bind StartPageShortcuts}"
                    IsItemClickEnabled="False"
                    SelectionMode="None"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    ScrollViewer.HorizontalScrollMode="Disabled"
                    ScrollViewer.VerticalScrollMode="Auto"
                    AutomationProperties.Name="Quick links"
                    AutomationProperties.AutomationId="StartPageShortcuts">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="4" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <GridView.ItemTemplate>
                        <DataTemplate>
                            <Button
                                Width="176"
                                Height="112"
                                Padding="16"
                                Click="OnStartPageShortcutClick"
                                Tag="{Binding Url}"
                                AutomationProperties.Name="{Binding Title}"
                                AutomationProperties.AutomationId="{Binding AutomationId}">
                                <StackPanel Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <FontIcon
                                        Glyph="{Binding Glyph}"
                                        FontSize="24"
                                        FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource BodyTextBlockStyle}" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </Grid>
        </Grid>
    </Grid>
</Page>
