<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WebKitBrowser.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded">

    <Grid x:Name="LayoutRoot" RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TabView
            x:Name="TabStrip"
            Grid.Row="0"
            Height="44"
            IsAddTabButtonVisible="True"
            CanReorderTabs="True"
            AddTabButtonClick="OnAddTabButtonClick"
            TabCloseRequested="OnTabCloseRequested"
            SelectionChanged="OnTabSelectionChanged"
            AutomationProperties.Name="Browser tabs"
            AutomationProperties.AutomationId="BrowserTabStrip" />

        <Grid
            x:Name="Toolbar"
            Grid.Row="1"
            Padding="12,6"
            ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button
                x:Name="BackButton"
                Grid.Column="0"
                Content="Back"
                Click="OnBackClick"
                VerticalAlignment="Center"
                AutomationProperties.Name="Go back"
                AutomationProperties.AutomationId="BackButton" />
            <Button
                x:Name="ForwardButton"
                Grid.Column="1"
                Content="Forward"
                Click="OnForwardClick"
                VerticalAlignment="Center"
                AutomationProperties.Name="Go forward"
                AutomationProperties.AutomationId="ForwardButton" />
            <Button
                Grid.Column="2"
                Content="Reload"
                Click="OnReloadClick"
                VerticalAlignment="Center"
                AutomationProperties.Name="Reload page"
                AutomationProperties.AutomationId="ReloadButton" />
            <Button
                Grid.Column="3"
                Content="Stop"
                Click="OnStopClick"
                VerticalAlignment="Center"
                AutomationProperties.Name="Stop loading"
                AutomationProperties.AutomationId="StopButton" />
            <Button
                Grid.Column="4"
                Content="Home"
                Click="OnHomeClick"
                VerticalAlignment="Center"
                AutomationProperties.Name="Go to home page"
                AutomationProperties.AutomationId="HomeButton" />

            <AutoSuggestBox
                x:Name="AddressBox"
                Grid.Column="5"
                MinWidth="180"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                PlaceholderText="Search or enter address"
                QuerySubmitted="OnAddressQuerySubmitted"
                AutomationProperties.Name="Address and search" AutomationProperties.AutomationId="AddressBox">
                <AutoSuggestBox.QueryIcon>
                    <SymbolIcon Symbol="Find" />
                </AutoSuggestBox.QueryIcon>
            </AutoSuggestBox>

            <Button
                x:Name="BookmarkButton"
                Grid.Column="6"
                Content="Bookmark"
                Click="OnBookmarkClick"
                VerticalAlignment="Center"
                AutomationProperties.Name="Add or remove bookmark"
                AutomationProperties.AutomationId="BookmarkButton" />
            <Button
                Grid.Column="7"
                Content="Saved"
                Click="OnBookmarksClick"
                VerticalAlignment="Center"
                AutomationProperties.Name="Open bookmarks"
                AutomationProperties.AutomationId="BookmarksButton" />
            <Button
                Grid.Column="8"
                Content="History"
                Click="OnHistoryClick"
                VerticalAlignment="Center"
                AutomationProperties.Name="Open browsing history"
                AutomationProperties.AutomationId="HistoryButton" />
            <Button
                Grid.Column="9"
                Content="Downloads"
                Click="OnDownloadsClick"
                VerticalAlignment="Center"
                AutomationProperties.Name="Open downloads"
                AutomationProperties.AutomationId="DownloadsButton" />
            <Button
                Grid.Column="10"
                Content="Settings"
                Click="OnSettingsClick"
                VerticalAlignment="Center"
                AutomationProperties.Name="Open browser settings"
                AutomationProperties.AutomationId="SettingsButton" />
        </Grid>

        <Grid
            x:Name="BrowserSurface"
            Grid.Row="2"
            Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
            SizeChanged="OnBrowserSurfaceSizeChanged">
            <InfoBar
                x:Name="EngineError"
                IsOpen="False"
                IsClosable="True"
                Severity="Error"
                Title="WebKit engine unavailable"
                Message="The WinCairo runtime could not be loaded. This browser will not fall back to Chromium or WebView2." />
        </Grid>
    </Grid>
</Page>
