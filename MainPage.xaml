<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="WebKitBrowser.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded">

    <Grid x:Name="LayoutRoot" RowSpacing="0">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="L" Modifiers="Control" Invoked="OnFocusAddressAccelerator" />
            <KeyboardAccelerator Key="T" Modifiers="Control" Invoked="OnNewTabAccelerator" />
            <KeyboardAccelerator Key="W" Modifiers="Control" Invoked="OnCloseTabAccelerator" />
            <KeyboardAccelerator Key="R" Modifiers="Control" Invoked="OnReloadAccelerator" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TabView
            x:Name="TabStrip"
            Grid.Row="0"
            Height="44"
            IsAddTabButtonVisible="True"
            CanReorderTabs="True"
            AddTabButtonClick="OnAddTabButtonClick"
            TabCloseRequested="OnTabCloseRequested"
            SelectionChanged="OnTabSelectionChanged"
            AutomationProperties.Name="Browser tabs"
            AutomationProperties.AutomationId="BrowserTabStrip" />

        <!-- Compact icon-only commands retain accessible names and tooltips. -->
        <Grid x:Name="Toolbar" Grid.Row="1" Padding="12,6" ColumnSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="BackButton" Grid.Column="0" Width="36" Height="36" Padding="0" Click="OnBackClick" AutomationProperties.Name="Go back" AutomationProperties.AutomationId="BackButton" ToolTipService.ToolTip="Back"><FontIcon Glyph="&#xE72B;" FontSize="16" FontFamily="{ThemeResource SymbolThemeFontFamily}" /></Button>
            <Button x:Name="ForwardButton" Grid.Column="1" Width="36" Height="36" Padding="0" Click="OnForwardClick" AutomationProperties.Name="Go forward" AutomationProperties.AutomationId="ForwardButton" ToolTipService.ToolTip="Forward"><FontIcon Glyph="&#xE72A;" FontSize="16" FontFamily="{ThemeResource SymbolThemeFontFamily}" /></Button>
            <Button x:Name="ReloadStopButton" Grid.Column="2" Width="36" Height="36" Padding="0" Click="OnReloadStopClick" AutomationProperties.Name="Reload page" AutomationProperties.AutomationId="ReloadStopButton" ToolTipService.ToolTip="Reload"><FontIcon x:Name="ReloadStopIcon" Glyph="&#xE72C;" FontSize="16" FontFamily="{ThemeResource SymbolThemeFontFamily}" /></Button>
            <Button x:Name="HomeButton" Grid.Column="3" Width="36" Height="36" Padding="0" Click="OnHomeClick" AutomationProperties.Name="Go to home page" AutomationProperties.AutomationId="HomeButton" ToolTipService.ToolTip="Home"><FontIcon Glyph="&#xE80F;" FontSize="16" FontFamily="{ThemeResource SymbolThemeFontFamily}" /></Button>
            <AutoSuggestBox x:Name="AddressBox" Grid.Column="4" MinWidth="180" HorizontalAlignment="Stretch" VerticalAlignment="Center" PlaceholderText="Search or enter address" QuerySubmitted="OnAddressQuerySubmitted" GotFocus="OnAddressGotFocus" LostFocus="OnAddressLostFocus" TextChanged="OnAddressTextChanged" AutomationProperties.Name="Address and search" AutomationProperties.AutomationId="AddressBox"><AutoSuggestBox.QueryIcon><SymbolIcon Symbol="Find" /></AutoSuggestBox.QueryIcon></AutoSuggestBox>
            <Button x:Name="BookmarkButton" Grid.Column="5" Width="36" Height="36" Padding="0" Click="OnBookmarkClick" AutomationProperties.Name="Add bookmark" AutomationProperties.AutomationId="BookmarkButton" ToolTipService.ToolTip="Add bookmark"><FontIcon Glyph="&#xE8A4;" FontSize="16" FontFamily="{ThemeResource SymbolThemeFontFamily}" /></Button>
            <Button x:Name="BookmarksButton" Grid.Column="6" Width="36" Height="36" Padding="0" Click="OnBookmarksClick" AutomationProperties.Name="Open bookmarks" AutomationProperties.AutomationId="BookmarksButton" ToolTipService.ToolTip="Bookmarks"><FontIcon Glyph="&#xE8A4;" FontSize="16" FontFamily="{ThemeResource SymbolThemeFontFamily}" /></Button>
            <Button x:Name="HistoryButton" Grid.Column="7" Width="36" Height="36" Padding="0" Click="OnHistoryClick" AutomationProperties.Name="Open browsing history" AutomationProperties.AutomationId="HistoryButton" ToolTipService.ToolTip="History"><FontIcon Glyph="&#xE81C;" FontSize="16" FontFamily="{ThemeResource SymbolThemeFontFamily}" /></Button>
            <Button x:Name="DownloadsButton" Grid.Column="8" Width="36" Height="36" Padding="0" Click="OnDownloadsClick" AutomationProperties.Name="Open downloads" AutomationProperties.AutomationId="DownloadsButton" ToolTipService.ToolTip="Downloads"><FontIcon Glyph="&#xE896;" FontSize="16" FontFamily="{ThemeResource SymbolThemeFontFamily}" /></Button>
            <Button x:Name="SettingsButton" Grid.Column="9" Width="36" Height="36" Padding="0" Click="OnSettingsClick" AutomationProperties.Name="Open browser settings" AutomationProperties.AutomationId="SettingsButton" ToolTipService.ToolTip="Settings"><FontIcon Glyph="&#xE713;" FontSize="16" FontFamily="{ThemeResource SymbolThemeFontFamily}" /></Button>
        </Grid>

        <ProgressBar
            x:Name="PageLoadingProgress"
            Grid.Row="2"
            Height="2"
            Minimum="0"
            Maximum="100"
            Value="0"
            IsIndeterminate="False"
            Visibility="Collapsed"
            IsTabStop="False"
            IsHitTestVisible="False"
            AutomationProperties.Name="Page loading progress"
            AutomationProperties.AutomationId="PageLoadingProgress" />

        <Grid
            x:Name="BrowserSurface"
            Grid.Row="3"
            Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
            SizeChanged="OnBrowserSurfaceSizeChanged">
            <InfoBar
                x:Name="EngineError"
                IsOpen="False"
                IsClosable="True"
                Severity="Error"
                Title="WebKit engine unavailable"
                Message="The WinCairo runtime could not be loaded. This browser will not fall back to Chromium or WebView2." />

            <!-- Native WinUI start page; no remote website is loaded for a new tab. -->
            <Grid
                x:Name="StartPageSurface"
                Visibility="Collapsed"
                Padding="32"
                Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                AutomationProperties.Name="Blaze start page"
                AutomationProperties.AutomationId="StartPageSurface">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Spacing="4" HorizontalAlignment="Center" Margin="0,28,0,0">
                    <TextBlock
                        Text="Blaze"
                        Style="{StaticResource TitleTextBlockStyle}"
                        HorizontalTextAlignment="Center" />
                    <TextBlock
                        Text="A fresh place to start browsing."
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        HorizontalTextAlignment="Center" />
                </StackPanel>

                <AutoSuggestBox
                    x:Name="StartPageSearchBox"
                    Grid.Row="1"
                    MaxWidth="720"
                    HorizontalAlignment="Stretch"
                    Margin="16,28,16,12"
                    PlaceholderText="Search the web or enter an address"
                    QuerySubmitted="OnStartPageSearchQuerySubmitted"
                    AutomationProperties.Name="Start page search"
                    AutomationProperties.AutomationId="StartPageSearchBox">
                    <AutoSuggestBox.QueryIcon>
                        <SymbolIcon Symbol="Find" />
                    </AutoSuggestBox.QueryIcon>
                </AutoSuggestBox>

                <TextBlock
                    Grid.Row="2"
                    Text="Quick links"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Margin="0,20,0,12"
                    HorizontalAlignment="Center" />

                <GridView
                    x:Name="StartPageShortcutsGrid"
                    Grid.Row="3"
                    IsItemClickEnabled="False"
                    SelectionMode="None"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    ScrollViewer.HorizontalScrollMode="Disabled"
                    ScrollViewer.VerticalScrollMode="Auto"
                    AutomationProperties.Name="Quick links"
                    AutomationProperties.AutomationId="StartPageShortcuts">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="4" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                </GridView>
            </Grid>
        </Grid>
    </Grid>
</Page>
