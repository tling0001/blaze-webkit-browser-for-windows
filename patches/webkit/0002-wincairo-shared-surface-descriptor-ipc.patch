+void RemoteWCLayerTreeHost::setSharedSurfaceDescriptor(Vector<uint8_t>&& descriptor)
+{
+    if (descriptor.size() != 152)
+        return;
+    uint32_t structSize = 0;
+    uint32_t protocolVersion = 0;
+    std::memcpy(&structSize, descriptor.data(), sizeof(structSize));
+    std::memcpy(&protocolVersion, descriptor.data() + sizeof(structSize), sizeof(protocolVersion));
+    if (structSize != descriptor.size() || protocolVersion != 2)
+        return;
+    m_sharedSurfaceDescriptor = WTF::move(descriptor);
+}
+
 } // namespace WebKit
