+void WebView::setSharedSurfaceDescriptor(const uint8_t* bytes, uint32_t size)
+{
+    if (!m_page || !bytes || size != 152)
+        return;
+
+    uint32_t structSize = 0;
+    uint32_t protocolVersion = 0;
+    std::memcpy(&structSize, bytes, sizeof(structSize));
+    std::memcpy(&protocolVersion, bytes + sizeof(structSize), sizeof(protocolVersion));
+    if (structSize != size || protocolVersion != 2)
+        return;
+
+    Vector<uint8_t> descriptor;
+    descriptor.append(bytes, size);
+    m_page->legacyMainFrameProcess().send(
+        Messages::WebPage::SetSharedSurfaceDescriptor(WTF::move(descriptor)),
+        m_page->webPageIDInMainFrameProcess());
+}
+
 } // namespace WebKit
